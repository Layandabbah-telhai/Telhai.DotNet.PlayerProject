<Window x:Class="Telhai.DotNet.PlayerProject.MusicPlayer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Classroom Music Player"
        Height="450"
        Width="800"
        Background="#222"
        Foreground="White"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">

        <!-- ROWS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MAIN AREA -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT SIDE ================= -->
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0">

                <!-- Status -->
                <TextBlock x:Name="txtStatus"
                           Text="Ready"
                           Foreground="#AAA"
                           HorizontalAlignment="Center"/>

                <!-- Album Artwork (FIXED - no cutting) -->
                <Border Background="#2F2F2F"
                        CornerRadius="10"
                        Width="180"
                        Height="180"
                        HorizontalAlignment="Center"
                        Margin="0,15,0,10">
                    <Image x:Name="imgArtwork"
                           Stretch="Uniform"
                           Margin="15"/>
                </Border>

                <!-- Song Name -->
                <TextBlock x:Name="txtCurrentSong"
                           Text="No Song Selected"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,5"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <!-- Artist Name -->
                <TextBlock x:Name="txtArtistName"
                           Text=""
                           FontSize="14"
                           Foreground="#DDD"
                           Margin="0,0,0,20"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <!-- Progress -->
                <Slider x:Name="sliderProgress"
                        IsMoveToPointEnabled="True"
                        Margin="0,0,0,20"
                        PreviewMouseLeftButtonDown="Slider_DragStarted"
                        PreviewMouseLeftButtonUp="Slider_DragCompleted"/>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Content="STOP"
                            Click="BtnStop_Click"
                            Width="80"
                            Height="40"
                            Margin="5"/>

                    <Button Content="PLAY"
                            Click="BtnPlay_Click"
                            Width="100"
                            Height="40"
                            Margin="5"
                            FontWeight="Bold"
                            Background="#007ACC"
                            Foreground="White"/>

                    <Button Content="PAUSE"
                            Click="BtnPause_Click"
                            Width="80"
                            Height="40"
                            Margin="5"/>
                </StackPanel>

                <!-- Volume -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">

                    <TextBlock Text="Volume "
                               VerticalAlignment="Center"/>

                    <Slider x:Name="sliderVolume"
                            Minimum="0"
                            Maximum="1"
                            Value="0.5"
                            Width="150"
                            ValueChanged="SliderVolume_ValueChanged"/>
                </StackPanel>

            </StackPanel>

            <!-- ================= RIGHT SIDE ================= -->
            <Grid Grid.Column="1"
                  Margin="10,0,0,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Library"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <ListBox x:Name="lstLibrary"
                         Grid.Row="1"
                         Background="#333"
                         Foreground="White"
                         SelectionChanged="LstLibrary_SelectionChanged"
                         MouseDoubleClick="LstLibrary_MouseDoubleClick"/>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            Margin="0,10,0,0">

                    <Button Content="Add MP3"
                            Click="BtnAdd_Click"
                            Width="70"
                            Margin="5"/>

                    <Button Content="Remove"
                            Click="BtnRemove_Click"
                            Width="70"
                            Margin="5"/>

                    <Button Content="Settings"
                            Click="BtnSettings_Click"
                            Width="70"
                            Margin="5"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ================= BOTTOM LEFT PATH ================= -->
        <TextBlock Grid.Row="1"
                   x:Name="txtMetaPath"
                   Text=""
                   Margin="5,15,5,0"
                   TextWrapping="Wrap"
                   Foreground="#BBB"
                   HorizontalAlignment="Left"/>
    </Grid>
</Window>